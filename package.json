{
  "name": "dsh-fastload",
  "version": "0.2.1",
  "type": "module",
  "description": "Reduce the first history page of long DSH sessions to two visible turns.",
  "license": "MIT",
  "author": "TLEWA",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TLEWA/dsh-fastload.git"
  },
  "homepage": "https://github.com/TLEWA/dsh-fastload#readme",
  "bugs": {
    "url": "https://github.com/TLEWA/dsh-fastload/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "session",
    "history",
    "performance",
    "lazy-load",
    "virtualization"
  ],
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs",
    "README.en.md",
    "CHANGELOG.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    },
    "manifestVersion": 1
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1"
  },
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "npx --yes --package=github:TLEWA/dsh-plugin-ci#v1 dsh-ci-gate --prepublish"
  }
}
