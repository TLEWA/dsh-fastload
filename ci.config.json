{
  "$schema": "https://raw.githubusercontent.com/TLEWA/dsh-plugin-ci/v1/schema/ci.config.schema.json",
  "version": 1,
  "build": null,
  "typecheck": null,
  "test": "npm test",
  "testGlobs": [
    "test/**/*.test.js"
  ],
  "manifest": {
    "manifestVersion": 1,
    "requireEnginesNode": true,
    "allowedInject": []
  },
  "docs": {
    "pairs": [
      [
        "README.md",
        "README.en.md"
      ],
      [
        "CHANGELOG.md",
        "CHANGELOG.en.md"
      ]
    ],
    "required": [
      "README.md",
      "CHANGELOG.md",
      "AGENTS.md",
      "LICENSE",
      ".github/PULL_REQUEST_TEMPLATE.md",
      ".github/workflows/ci.yml",
      ".github/workflows/drift.yml",
      ".github/workflows/release.yml",
      "README.en.md",
      "CHANGELOG.en.md"
    ],
    "published": [
      "README.md",
      "CHANGELOG.md",
      "LICENSE",
      "README.en.md",
      "CHANGELOG.en.md"
    ]
  },
  "tarball": {
    "mustInclude": [
      "index.js",
      "client.js",
      "cordis.patch.yml",
      "README.md",
      "CHANGELOG.md",
      "LICENSE",
      "README.en.md",
      "CHANGELOG.en.md"
    ],
    "mustExclude": [
      "test/**",
      ".github/**",
      "*.tgz",
      "node_modules/**",
      ".ci/**"
    ],
    "maxBytes": 1048576
  },
  "release": {
    "publish": true,
    "provenance": true
  },
  "guards": {
    "requireHumanApprovedLabel": true
  }
}
